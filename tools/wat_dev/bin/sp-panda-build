#!/usr/bin/env bash
# Build only the panda firmware (sp-build --panda). sp-build handles worktrees and refuses
# firmware stamped DEV-unknown-DEBUG.
# Usage: sp-panda-build [args for ./build --panda]
set -euo pipefail
"$(dirname "$0")/sp-build" --panda "$@"
echo "sp-panda-build: firmware version $(cat "$(git rev-parse --show-toplevel)/panda/board/obj/version")"
