# Your laptop's SSH *public* key (cat ~/.ssh/id_ed25519.pub), on one line
AUTHORIZED_KEY=
# Password for the VNC desktop (port 5900 and noVNC on 6080). Only the first 8 characters count.
VNC_PASSWORD=
# One host folder holding everything, on a direct pool path (not /mnt/user), e.g.
#   /mnt/nvme-pool/Development/projects/starpilot
# Layout inside it:  workspace/ (your clones)   ccache/   uv_cache/   home/ (= /home/batman)   tmp/ (= /tmp)
#   sysroot/ (AGNOS sysroot for ./build)   build_cache/ (AGNOS image, scons cache)
# It is mounted at the same path inside the container.
DEV_ROOT=
