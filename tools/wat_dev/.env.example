# Your laptop's SSH *public* key (cat ~/.ssh/id_ed25519.pub), on one line
AUTHORIZED_KEY=
# One host folder holding everything, on a direct pool path (not /mnt/user), e.g.
#   /mnt/nvme-pool/Development/projects/starpilot
# Layout inside it:  workspace/ (your clones)   ccache/   uv_cache/
# It is mounted at the same path inside the container.
DEV_ROOT=
