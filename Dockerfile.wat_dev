# Layered on the repo's own base image (Dockerfile.openpilot_base), built by the
# base-image workflow and pushed to the Forgejo registry. Override with
# --build-arg BASE_IMAGE=... to use a different tag.
ARG BASE_IMAGE=git.waffle/waffle/starpilot-base:latest
FROM ${BASE_IMAGE}

ARG DEV_USER=batman
# Unraid's default owner for shares is nobody:users (99:100)
ARG DEV_UID=99
ARG DEV_GID=100

USER root
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      openssh-server supervisor \
      x11vnc fluxbox novnc websockify xterm xfce4-terminal dbus-x11 \
      ccache gdb rsync htop jq ripgrep less \
      nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && git lfs install --system \
    && git config --system --add safe.directory '*' \
    && mkdir -p /run/sshd \
    && update-alternatives --set x-terminal-emulator /usr/bin/xfce4-terminal.wrapper

# Docker CLI + compose plugin (client only) so ./build can start the arm64
# builder container through the host's /var/run/docker.sock. The CLI version
# matches the Unraid host (27.5.1).
ARG DOCKER_VERSION=27.5.1
ARG COMPOSE_VERSION=v2.32.4
RUN curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz" \
      | tar -xz --strip-components=1 -C /usr/local/bin docker/docker \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL "https://github.com/docker/compose/releases/download/${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
         -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Claude Code CLI, installed system-wide (not under ~) so the persistent home
# volume can't shadow it. Log in once inside the container; credentials land in
# ~/.claude on the home volume. Rebuild the image to update.
RUN npm install -g @anthropic-ai/claude-code

# uv is installed under ~/.local/bin by the base image, but /home/batman is
# bind-mounted over at run time. Copy the binaries somewhere the mount can't hide.
RUN cp /home/${DEV_USER}/.local/bin/uv /usr/local/bin/uv \
    && if [ -f /home/${DEV_USER}/.local/bin/uvx ]; then cp /home/${DEV_USER}/.local/bin/uvx /usr/local/bin/uvx; fi

# Remap the base image's user onto Unraid's nobody:users so files in the
# bind-mounted workspace have sane ownership on the host.
# usermod -u chowns the whole home tree, and the base's 6 GB .venv lives there:
# that rewrites every file into a new 6 GB layer. Point the account at a
# nonexistent home while remapping so nothing is chowned; /home/batman is a bind
# mount at run time anyway, and the seed below is chowned on its own.
RUN usermod -d /nonexistent ${DEV_USER} \
    && usermod -o -u ${DEV_UID} -g ${DEV_GID} ${DEV_USER} \
    && usermod -d /home/${DEV_USER} ${DEV_USER} \
    && chown ${DEV_UID}:${DEV_GID} /home/${DEV_USER} \
    && echo "${DEV_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev

# /home/batman is a bind mount (DEV_ROOT/home) that starts empty and hides the
# image's copy. Keep the base's dotfiles here so the entrypoint can seed it. The
# base's .venv is skipped (each clone gets its own), and so are uv/uvx (the copies
# in /usr/local/bin are the image's; a seeded one in ~/.local/bin would shadow them
# and go stale on rebuilds).
RUN rsync -a --chown=${DEV_UID}:${DEV_GID} --exclude=/.venv --exclude=/.local/bin/uv --exclude=/.local/bin/uvx \
      /home/${DEV_USER}/ /opt/home-seed/

COPY tools/wat_dev/supervisord.conf /etc/supervisor/conf.d/dev.conf
COPY tools/wat_dev/entrypoint.sh /entrypoint.sh
COPY tools/wat_dev/Xresources /etc/wat-dev.Xresources
COPY tools/wat_dev/bin/sp-agnos-check tools/wat_dev/bin/sp-build /usr/local/bin/
RUN chmod +x /entrypoint.sh

# CCACHE_DIR / UV_CACHE_DIR / REPOS_DIR are set by docker-compose (all under DEV_ROOT).
ENV DEV_USER=${DEV_USER} DISPLAY=:1
EXPOSE 22 6080
ENTRYPOINT ["/entrypoint.sh"]
