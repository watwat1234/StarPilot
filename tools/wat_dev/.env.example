# Your laptop's SSH *public* key (cat ~/.ssh/id_ed25519.pub), on one line
AUTHORIZED_KEY=
# Login password for browser code-server on :8443 (avoid $ and quotes)
CODE_SERVER_PASSWORD=
# Host path of the StarPilot clone to mount at /workspace, e.g. /mnt/<share>/starpilot/workspace
WORKSPACE_DIR=
# Host path for the shared ccache, e.g. /mnt/<share>/starpilot/ccache
CCACHE_HOST_DIR=
