# Your laptop's SSH *public* key (cat ~/.ssh/id_ed25519.pub), on one line
AUTHORIZED_KEY=
# Host folder that holds your StarPilot clones/worktrees, e.g. /mnt/<share>/starpilot/repos
# (mounted at the same path inside the container)
REPOS_DIR=
# Host path for the shared ccache, e.g. /mnt/<share>/starpilot/ccache
CCACHE_HOST_DIR=
